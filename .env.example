# Copy to .env (production, used by docker compose) or .env.local (development).

# Required. Encrypts the Claude API key and other secrets stored in the database.
# Generate with: openssl rand -base64 32
# Keep it safe: if it is lost, stored secrets must be re-entered.
REX_ENCRYPTION_KEY=

# Where the SQLite database lives. The Docker image uses /app/data/rex.db.
DATABASE_PATH=./data/rex.db

# Domain Caddy requests an HTTPS certificate for (production only),
# e.g. rex.example.com. Point its DNS A record at your server first.
REX_DOMAIN=

# Session cookies are HTTPS-only in production. Set to false only if you
# must run without HTTPS (not recommended: the site is open to the internet).
COOKIE_SECURE=true

# Nightly encrypted backups of the database, kept in data/backups (inside the Docker volume).
# They are encrypted with REX_ENCRYPTION_KEY: keep a copy of that key off the server.
REX_BACKUPS=on
# Local hour (your Rex time zone) after which the nightly backup runs.
REX_BACKUP_HOUR=2
REX_BACKUP_RETENTION_DAYS=30
# Optional: a different folder for backups (outside Docker), e.g. /mnt/backup-disk/rex
# REX_BACKUP_DIR=
